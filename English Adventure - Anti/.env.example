# English Adventure – Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# NEVER hardcode these values in GDScript files.

# Supabase Configuration
# Get these from your Supabase project settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# NOTE: Never put the service_role key here or anywhere in the game client.
# The service_role key is only for server-side admin tasks (migrations, scripts).

# Development Environment
APP_ENV=development
# Options: development | staging | production

# Optional: Override audio CDN base URL for local development
# AUDIO_BASE_URL=http://localhost:3000/audio

# Optional: Enable verbose logging in development
# DEBUG_LOGGING=true
