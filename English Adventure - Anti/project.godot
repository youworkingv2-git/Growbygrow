; Engine configuration file.
; It's best edited using the editor UI and not directly,
; some parameters are not reflected in the documentation and may be regenerated.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="English Adventure"
config/description="A Fun English Learning Adventure Game for Children"
config/version="0.1.0-mvp"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.3", "Mobile")

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
SaveManager="*res://scripts/save_load/save_manager.gd"
LocalizationManager="*res://scripts/localization/localization_manager.gd"
DialogueManager="*res://scripts/dialogue/dialogue_manager.gd"
QuestManager="*res://scripts/quest/quest_manager.gd"
InteractionManager="*res://scripts/interaction/interaction_manager.gd"
GameManager="*res://scripts/core/game_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[filesystem]

import/blender/enabled=false

[input]

ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194311,"physical_keycode":0,"key_label":0,"unicode":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":false,"script":null)
]
}

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
