layout_mode = 2
texture = ExtResource("3_owl")
expand_mode = 1
stretch_mode = 5

[node name="TitleCol" type="VBoxContainer" parent="Margin/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="TitleLabel" type="Label" parent="Margin/VBox/Header/TitleCol"]
layout_mode = 2
