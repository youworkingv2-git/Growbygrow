# ==============================================================================
# ENGLISH ADVENTURE - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to `.env` for local tooling / build scripts.
# NEVER commit `.env` or real keys to Git.
# NEVER bundle SUPABASE_SERVICE_ROLE_KEY into the Godot client build!
# ==============================================================================

# --- Client-Safe Configuration (Public Anon Key protected by PostgreSQL RLS) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key-here
APP_ENV=development
DEFAULT_UI_LOCALE=vi
DEFAULT_ACCENT=en-US

# --- Server / CI / Admin Tooling ONLY (NEVER put in Godot client) ---
# Used solely by migration / content-seeding scripts in secure CI or local admin shell.
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=never-ship-this-in-client-build
