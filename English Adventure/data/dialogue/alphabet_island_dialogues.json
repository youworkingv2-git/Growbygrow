{
  "dialogues": {
    "world_intro": [
      {
        "speaker_id": "professor_owl",
        "speaker_name_vi": "Giáo sư Cú Mèo",
        "speaker_name_en": "Professor Owl",
        "portrait": "res://assets/characters/npcs/professor_owl.svg",
        "buddy_state": "talking",
        "text_en": "Welcome, young adventurer!",
        "text_vi": "Chào mừng nhà thám hiểm trẻ tuổi đến với Lingua Realm! Ta là Giáo sư Cú Mèo."
      },
      {
        "speaker_id": "buddy",
        "speaker_name_vi": "Buddy (Rồng Nhỏ)",
        "speaker_name_en": "Buddy",
        "portrait": "res://assets/characters/buddy/buddy_dragon.svg",
        "buddy_state": "happy",
        "text_en": "Hi! I am Buddy. Let's explore the island together!",
        "text_vi": "Xin chào! Tớ là Buddy. Từ nay tớ sẽ bay cùng cậu khám phá hòn đảo kỳ diệu này nhé!"
      },
      {
        "speaker_id": "professor_owl",
        "speaker_name_vi": "Giáo sư Cú Mèo",
        "speaker_name_en": "Professor Owl",
        "portrait": "res://assets/characters/npcs/professor_owl.svg",
        "buddy_state": "sad",
        "text_en": "The letters have disappeared. We need your help!",
        "text_vi": "Thế lực bóng tối The Silent Shadow đã đánh cắp chữ cái và âm thanh. Sách vở trống rỗng, biển báo mất chữ! Hãy giúp chúng ta khôi phục Đảo Bảng Chữ Cái!"
      },
      {
        "speaker_id": "buddy",
        "speaker_name_vi": "Buddy (Rồng Nhỏ)",
        "speaker_name_en": "Buddy",
        "portrait": "res://assets/characters/buddy/buddy_dragon.svg",
        "buddy_state": "celebrating",
        "text_en": "Let's go to Welcome Village!",
        "text_vi": "Đừng lo nhé, tớ sẽ dịch và hướng dẫn từng bước bằng tiếng Việt. Chúng ta cùng tới Làng Khởi Đầu thôi!"
      }
    ],
